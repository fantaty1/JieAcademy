# ============================================================
# TradingView-Binance 自动量化交易系统 配置文件模板
# ============================================================
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 填入你自己的配置信息
# 3. 绝对不要将 .env 文件提交到版本控制系统
# ============================================================

# ============== 币安API配置 ==============
# 从 https://www.binance.com/zh-CN/my/settings/api-management 获取
# 【重要安全提示】API Key只能开启"现货交易"权限，绝对不要开启"提现"权限！
# 【重要安全提示】务必在币安后台设置API Key的IP白名单，只允许服务器IP访问

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 是否使用测试网 (True/False)
# 首次使用请务必设置为 True，在测试网验证无误后再切换到主网
USE_TESTNET=True

# ============== Webhook安全配置 ==============
# 这个密钥用于验证TradingView发来的Webhook请求
# 请设置一个复杂的随机字符串，TradingView警报消息中需要包含此密钥
WEBHOOK_SECRET=your_webhook_secret_here_change_this

# ============== 风控参数配置 ==============

# 全局交易开关 (True=开启交易, False=停止所有交易)
# 紧急情况下可设置为False一键停止所有自动交易
TRADING_ENABLED=True

# 单次下单最大资金比例 (0.1表示不超过账户总资金的10%)
MAX_ORDER_RATIO=0.1

# 重复信号过滤时间窗口（秒）
# 同一交易对的同一方向信号，在此时间内只执行一次
DUPLICATE_SIGNAL_WINDOW=60

# 每日最大交易次数
MAX_DAILY_TRADES=50

# ============== 通知配置（可选） ==============
# 设置为True开启交易通知
ENABLE_NOTIFICATIONS=False

# 企业微信Webhook地址（可选）
WECOM_WEBHOOK_URL=

# 邮件通知配置（可选）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# ============== 服务器配置 ==============
# 服务监听地址和端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
