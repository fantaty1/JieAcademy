[Unit]
Description=TradingView-Binance 自动量化交易系统
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/tv-trader
Environment="PATH=/opt/tv-trader/venv/bin"
ExecStart=/opt/tv-trader/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
